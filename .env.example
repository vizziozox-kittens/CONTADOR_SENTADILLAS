# URL pública del servidor, sin / al final.
# Ejemplo: https://tu-app.onrender.com
PUBLIC_URL=https://TU-URL-PUBLICA.onrender.com

# Credenciales de tu aplicación de Twitch.
# NO publiques este archivo con valores reales.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con la URL registrada en Twitch.
TWITCH_REDIRECT_URI=https://TU-URL-PUBLICA.onrender.com/auth/twitch/callback

# Render asigna PORT automáticamente; no es necesario cambiarlo.
