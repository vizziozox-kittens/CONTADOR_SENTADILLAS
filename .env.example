# ============================================================
# CONFIGURACION LOCAL
# ============================================================
# Para ejecutar el proyecto en tu PC:
PUBLIC_URL=http://localhost:3000

# Credenciales de tu aplicacion de Twitch.
# NO publiques valores reales en GitHub.
TWITCH_CLIENT_ID=TU_CLIENT_ID
TWITCH_CLIENT_SECRET=TU_CLIENT_SECRET

# Redirect URI LOCAL.
# Esta URL debe estar registrada en tu aplicacion de Twitch.
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# PostgreSQL local o la conexion que utilices.
DATABASE_URL=TU_DATABASE_URL

# ============================================================
# CONFIGURACION EN RENDER
# ============================================================
# En Render utiliza estos valores como Environment Variables:
#
# PUBLIC_URL=https://contador-sentadillas.onrender.com
# TWITCH_CLIENT_ID=TU_CLIENT_ID
# TWITCH_CLIENT_SECRET=TU_CLIENT_SECRET
# TWITCH_REDIRECT_URI=https://contador-sentadillas.onrender.com/auth/twitch/callback
# DATABASE_URL=TU_DATABASE_URL
#
# IMPORTANTE:
# En Twitch Developer Console registra AMBAS Redirect URLs:
#
# http://localhost:3000/auth/twitch/callback
# https://contador-sentadillas.onrender.com/auth/twitch/callback
#
# El Client Secret y DATABASE_URL nunca deben subirse a GitHub.
